# --- Base de datos ---------------------------------------------------------
# Sin DATABASE_URL la app arranca en MODO DEMO: Postgres en memoria (PGlite)
# con estudios de ejemplo que se reinician con cada arranque.
# En producción usa el pooler de transacciones de Supabase (puerto 6543):
# DATABASE_URL=postgres://USUARIO.REF_PROYECTO:CONTRASEÑA@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require

# Con SEED_DEMO_DATA=1 una base de datos vacía se rellena con los estudios de
# ejemplo al primer arranque y se muestran los botones de cuentas demo en /login.
# SEED_DEMO_DATA=1

# --- Sitio -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://kabina.studio

# --- Stripe (opcional) --------------------------------------------------------
# Con estas claves los pagos son reales (Stripe Checkout + Connect Express).
# Sin ellas, las reservas se confirman sin cobrar.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # endpoint: /api/stripe/webhook
